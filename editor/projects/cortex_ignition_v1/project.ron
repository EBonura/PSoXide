            nodes: [
                /*[0]*/ (id: (1), parent: None, children: [(2), (3), (4), (5), (6), (7), (8), (10), (11), (12), (13), (14), (15), (16), (17), (21), (18), (19), (20)], name: "Canvas", kind: Canvas(width: 320, height: 240), visible_when: Always),
                /*[1]*/ (id: (2), parent: Some((1)), children: [], name: "Backdrop", kind: Rect(rect: (x: 0, y: 0, width: 320, height: 240, anchor: TopLeft, rotation_degrees: 0, flip_x: false, flip_y: false), color: (14, 7, 10), gradient: Some((to: (4, 2, 4), direction: Vertical))), visible_when: Always),
