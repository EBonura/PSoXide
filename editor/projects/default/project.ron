            nodes: [
                /*[0]*/ (id: (1), parent: None, children: [(2), (3), (4), (5), (6), (7), (8), (10), (11), (12), (13), (14), (15), (16), (17), (21), (18), (19), (20)], name: "Canvas", kind: Canvas(width: 320, height: 240), visible_when: Always),
