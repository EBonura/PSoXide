                /*[3]*/ (id: (4), parent: Some((1)), children: [], name: "System Title", kind: Label(rect: (x: 24, y: 38, width: 220, height: 14, anchor: TopLeft, rotation_degrees: 0, flip_x: false, flip_y: false), text: "CORTEX // PROJECTION LINK", random_message: false, messages: [], tag: "", align: Left, wrap: false, font: KenneyFuture, font_scale: 0.69921875, letter_spacing: 1, color: (242, 242, 247), gradient: None, effect: None), visible_when: Always),
                /*[4]*/ (id: (5), parent: Some((1)), children: [], name: "Archive Caption", kind: Label(rect: (x: 24, y: 60, width: 180, height: 10, anchor: TopLeft, rotation_degrees: 0, flip_x: false, flip_y: false), text: "ARCHIVE FRAGMENT // PARTIAL", random_message: false, messages: [], tag: "", align: Left, wrap: false, font: Basic, font_scale: 0.5, letter_spacing: 1, color: (184, 111, 108), gradient: None, effect: None), visible_when: Always),
                /*[5]*/ (id: (6), parent: Some((1)), children: [], name: "Lore Frame", kind: Rect(rect: (x: 22, y: 72, width: 275, height: 96, anchor: TopLeft, rotation_degrees: 0, flip_x: false, flip_y: false), color: (70, 18, 12), gradient: None), visible_when: Always),
                /*[6]*/ (id: (7), parent: Some((1)), children: [], name: "Lore Panel", kind: Rect(rect: (x: 23, y: 73, width: 273, height: 94, anchor: TopLeft, rotation_degrees: 0, flip_x: false, flip_y: false), color: (24, 10, 14), gradient: Some((to: (10, 4, 8), direction: Vertical))), visible_when: Always),
                /*[7]*/ (id: (8), parent: Some((1)), children: [], name: "Lore Message", kind: Label(rect: (x: 33, y: 82, width: 253, height: 76, anchor: TopLeft, rotation_degrees: 0, flip_x: false, flip_y: false), text: "The path to the surface was sealed long before the sleepers were born. Its makers left no map, only ascending chambers, silent mechanisms and arches that still answer to forgotten commands. Every passage leading upward was built for a return. None were built to guarantee that return would be welcomed.", random_message: true, messages: ["Beneath the dead soil, the last Sapiens lie in chambers built for a dawn that did not come. Thirty thousand years have passed without witness, yet the machines continue to count each sleeping breath. Whether they preserve humanity or merely its memory is a question no sleeper can answer.", "Aletha has no flesh to wound and no blood to spill. Her body is a congregation of machines, gathered around the image of a woman who may never have existed as she appears. When the swarm parts, the projection dies for an instant. Each time it returns, something may be missing.", "The path to the surface was sealed long before the sleepers were born. Its makers left no map, only ascending chambers, silent mechanisms and arches that still answer to forgotten commands. Every passage leading upward was built for a return. None were built to guarantee that return would be welcomed.", "Near the Cortex, matter appears to surrender its certainty. Stone becomes a grid, surfaces lose their colour, and solid forms scatter into isolated points. Some records call this corruption. Others suggest the world has always been so, and that distance merely conceals its true construction.", "Dust gathers where memory has failed. It settles into the outlines of vanished walls, abandoned machines and bodies removed from history. Disturb it, and those shapes dissolve once more. Yet the dust always returns, as though the world remembers what stood there even when its inhabitants do not.", "For thirty thousand years, the chambers below consumed the last stored light of the old world. At last there is enough energy to send a projection upward, but not enough to waste. Aletha\'s journey is therefore measured in fragments: every movement a calculation, every reconstruction a small act of survival."], tag: "", align: Left, wrap: true, font: KenneyFuture, font_scale: 0.55078125, letter_spacing: 0, color: (235, 236, 238), gradient: Some((to: (184, 111, 108), direction: Vertical)), effect: None), visible_when: Always),
                /*[8]*/ (id: (10), parent: Some((1)), children: [], name: "Wind Streak A", kind: Image(rect: (x: -72, y: 166, width: 10, height: 2, anchor: TopLeft, rotation_degrees: 0, flip_x: false, flip_y: false), texture: None, tint: (255, 120, 70), effect: Wind), visible_when: Always),
