+/// Determinant of three view-space positions: the screen-space signed area
+/// of the projected triangle carries its sign (verified numerically against
+/// `culled_soft` over random front triangles), independent of the integer
+/// projection of near-clipped slivers whose winding flips.
+#[inline(always)]
+fn culled_view_det(a: &render::CVert, b: &render::CVert, c: &render::CVert) -> i64 {
+    let (ax, ay, az) = (a.v[0] as i64, a.v[1] as i64, a.v[2] as i64);
+    let (bx, by, bz) = (b.v[0] as i64, b.v[1] as i64, b.v[2] as i64);
+    let (cx, cy, cz) = (c.v[0] as i64, c.v[1] as i64, c.v[2] as i64);
+    ax * (by * cz - bz * cy) - ay * (bx * cz - bz * cx) + az * (bx * cy - by * cx)
+}
+
+/// Back-face verdict before clipping or projection: the same verdict as
+/// `culled_soft` on the projected triangle when it is wholly in front.
+#[inline(always)]
+fn culled_view(a: &render::CVert, b: &render::CVert, c: &render::CVert) -> bool {
+    culled_view_det(a, b, c) >= 0
+}
