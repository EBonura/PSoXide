+/// Diagnostic: one line of `label` followed by decimal `words`.
+#[cfg(all(target_arch = "mips", feature = "emulator-telemetry"))]
+#[inline(never)]
+pub fn debug_log_words(label: &str, words: &[i32]) {
+    debug_bytes(label.as_bytes());
+    for &w in words {
+        debug_byte(b' ');
+        let mut v = w;
+        if v < 0 {
+            debug_byte(b'-');
+            v = -v;
+        }
+        let mut digits = [0u8; 11];
+        let mut n = 0usize;
+        loop {
+            digits[n] = b'0' + (v % 10) as u8;
+            n += 1;
+            v /= 10;
+            if v == 0 {
+                break;
+            }
+        }
+        while n > 0 {
+            n -= 1;
+            debug_byte(digits[n]);
+        }
+    }
+    debug_byte(b'\n');
+}
+
+#[cfg(not(all(target_arch = "mips", feature = "emulator-telemetry")))]
+#[inline(always)]
+pub fn debug_log_words(_label: &str, _words: &[i32]) {}
+
 // In shipping and host builds every call still compiles away completely.
 #[cfg(not(all(target_arch = "mips", feature = "emulator-telemetry")))]
 #[inline(always)]
